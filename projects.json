{
  "categories": [
    {
      "id": "commercial",
      "label": "Commercial & Corporate",
      "intro": "My corporate and commercial work spans on-set production and post-production. I assist startups on set to bring their image videos to life, while also working as a motion designer to create engaging commercial content."
    },
    {
      "id": "social",
      "label": "Social",
      "intro": "My background includes also a year and a half as the video editor for a major YouTube channel with over 2.6 million subscribers. Now, I partner with creators and brands to produce impactful content across fashion, animation, events, and music videos."
    },
    {
      "id": "documentary",
      "label": "Documentary",
      "intro": "My documentary experience focuses on editing and color grading, primarily collaborating with NGOs on projects across Africa to bring impactful, real-world stories to light."
    },
    {
      "id": "motion-graphic",
      "label": "Motion Graphic",
      "intro": "My motion graphics work ranges from handling long and complex music video projects to integrating VFX and animation into social reels."
    },
    {
      "id": "events",
      "label": "Events",
      "intro": "I help capture the energy of tech and IT conferences, working seamlessly as a solo freelancer or as part of a larger team to deliver high-impact event coverage."
    }
  ],
